    {
      "case_id": "ftincrem.FT_Incremental_InterfaceRec.open_face_stores_interface",
      "subject": "ftincrem.FT_Incremental_InterfaceRec",
      "case": "open_face_stores_interface",
      "operation": "ftincrem.opaque_handle_lifecycle",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "object_cookie": "inaccessible_opaque_sentinel",
          "callbacks": [
            "get_glyph_data",
            "free_glyph_data"
          ],
          "open_args_flags": [
            "FT_OPEN_MEMORY",
            "FT_OPEN_PARAMS"
          ],
          "face_index": 0,
          "glyph_index": 36,
          "load_flags": "FT_LOAD_NO_SCALE",
          "runtime_route": "actual_incremental_interface_storage"
        }
      },
      "classifiers": [
        "kind:record",
        "runtime:open_face",
        "source:ftobjs"
      ],
      "expectation": {
        "status": "build_dependent",
        "output_shape": {
          "callback_events": "array<callback_event>",
          "object_identity": "pointer_identity",
          "dereferenced_by_freetype": "bool"
        },
        "compare": {
          "mode": "identity_class",
          "paths": [
            "callback_events.object_identity",
            "object_identity",
            "dereferenced_by_freetype"
          ]
        },
        "source_refs": [
          "freetype/src/base/ftobjs.c"
        ],
        "fixture_requirements": [
          "The tracked DejaVuSans.ttf is opened through FT_OPEN_MEMORY|FT_OPEN_PARAMS with FT_PARAM_TAG_INCREMENTAL. Callback execution after open proves the face retained the caller-owned interface; the opaque object identity is compared without dereference."
        ]
      }
    },
    {
      "case_id": "ftincrem.FT_Incremental_InterfaceRec.object_round_trips_to_callbacks",
      "subject": "ftincrem.FT_Incremental_InterfaceRec",
      "case": "object_round_trips_to_callbacks",
      "operation": "ftincrem.callback_object_identity",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "input/fonts/incremental/minimal-glyf-incremental.ttf"
          }
        },
        "params": {
          "object_cookie": "opaque_client_pointer",
          "callbacks": [
            "get_glyph_data",
            "free_glyph_data",
            "get_glyph_metrics"
          ],
          "glyph_index": 1,
          "assert_each_callback_receives_object_cookie": true
        }
      },
      "classifiers": [
        "kind:record",
        "runtime:incremental_callbacks",
        "pointer_identity"
      ],
      "expectation": {
        "status": "build_dependent",
        "output_shape": {
          "callback_events": "array<callback_event>",
          "object_identity": "pointer_identity"
        },
        "compare": {
          "mode": "identity_class",
          "paths": [
            "callback_events.callback_name",
            "callback_events.object_identity"
          ]
        },
        "source_refs": [
          "freetype/include/freetype/ftincrem.h",
          "freetype/src/truetype/ttgload.c"
        ],
        "fixture_requirements": [
          "Requires a runtime row that causes at least get_glyph_data and free_glyph_data to fire; metrics callback may be skipped for formats that do not request it."
        ]
      }
    },
    {
