      "operation": "ftpfr.get_pfr_kerning",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/pfr/basic-metrics-and-kerning.pfr"
          }
        },
        "params": {
          "face_index": 0,
          "pairs": [
            "gid:1/gid:2",
            "gid:2/gid:1",
            "gid:0/gid:1",
