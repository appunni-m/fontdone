      "metadata": {
        "expansion_reason": "The existing error_null_face case validates the public C-shaped null-face call but its harness short-circuits before the exported C ABI and WASM handle wrappers. This dedicated case keeps the public null-face shape and attaches the maintained font only to select those ABI routes, where handle 0 must be rejected.",
        "oracle_verdict": "Pinned FreeType freetype/src/base/ftobjs.c:3532-3558 normalizes the point-size and resolution inputs and deliberately defers face validation to FT_Request_Size; freetype/src/base/ftobjs.c:3446-3447 returns FT_Err_Invalid_Face_Handle for the null face.",
        "source_refs": [
          "freetype/src/base/ftobjs.c:3446-3447",
          "freetype/src/base/ftobjs.c:3532-3558",
          "fontdone-c-abi/src/implementation.rs:23030-23051",
          "fontdone-wasm/src/implementation.rs:8043-8064"
        ]
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:invalid_handle"
      ],
