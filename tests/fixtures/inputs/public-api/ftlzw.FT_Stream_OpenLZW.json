      "metadata": {
        "expansion_reason": "A public FT_Stream source callback that returns nonzero for the required zero-count seek reaches the C ABI lzw_source_bytes Invalid_Stream_Operation return.",
        "original_freetype_behavior": "Pinned FreeType 2.14.3 ft_lzw_check_header calls FT_STREAM_SEEK(0), and ftstream.c propagates a nonzero zero-count callback result as a stream-operation error before reading the two-byte magic.",
        "source_refs": [
          "freetype/src/lzw/ftlzw.c:82-91",
          "freetype/src/base/ftstream.c:56-72",
          "fontdone-c-abi/src/implementation.rs:1531-1535"
        ]
      },
