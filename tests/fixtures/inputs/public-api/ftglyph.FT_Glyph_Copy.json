        "kind:function",
        "header:ftglyph",
        "runtime:wasm-facade",
        "malformed_record",
        "validation-order"
      ],
      "metadata": {
        "source_behavior": "The WASM SVG-glyph record imports a nonempty document and the published root format before FT_Svg_Glyph_Copy validates the class-specific format. Unsupported root formats return FT_Err_Invalid_Glyph_Format and leave the wrapper target null. The native C surface has no equivalent public record mutation route, so the oracle lane asserts this adapter-specific validation result explicitly.",
        "batch_history": "Initial MCP coverage batch exercised unsupported root formats 1 through 100 with the SVG document preserved; MCP measured lines 3692 and 2275 plus one branch and three regions, so 99 redundant variants were pruned to witness c64-svg-format-001."
      },
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "probe": "root.format=<value>",
          "source_format": "<value>",
          "source_document_nonempty": true,
          "target_pointer_class": "null"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "error",
            "output.probe",
            "output.source_format",
            "output.source_document_nonempty",
            "output.target_pointer_class"
          ]
        },
        "error": "FT_Err_Invalid_Glyph_Format",
        "source_refs": [
          "freetype/include/freetype/ftglyph.h",
          "fontdone-wasm/src/implementation.rs:541-580",
          "fontdone-wasm/src/implementation.rs:3687-3692"
        ]
      }
