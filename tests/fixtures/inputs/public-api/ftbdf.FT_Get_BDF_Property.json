          "paths": [
            "error",
            "property_name",
            "property_after.type",
            "property_after.atom_string",
            "property_after.integer",
            "property_after.cardinal"
          ]
        },
        "fixture_requirements": [
          "Thirty project-authored BDF faces with one known integer or cardinal property carrying a deliberate malformed numeric token",
          "Each face remains loadable so FT_Get_BDF_Property observes the parsed public property"
        ],
