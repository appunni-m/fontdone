    {
      "case_id": "ftmodapi.FT_New_Library.creates_library_with_version_and_refcount",
      "subject": "ftmodapi.FT_New_Library",
      "case": "creates_library_with_version_and_refcount",
      "operation": "ftmodapi.new_library",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {},
        "params": {
          "memory": "valid_counting_FT_MemoryRec",
          "alibrary_initial": "sentinel_non_null",
          "post_checks": [
            "FT_Library_Version",
            "FT_Get_Module(truetype) before FT_Add_Default_Modules",
            "FT_Reference_Library then FT_Done_Library"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftmodapi",
        "area:library",
        "area:allocator"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "status": "FT_Error",
          "library_handle": "FT_Library",
          "version_fields": {
            "major": "FT_Int",
            "minor": "FT_Int",
            "patch": "FT_Int"
          },
          "refcount_initial": "integer",
          "memory_pointer_identity": "same_as_input",
          "default_modules_installed": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "library_handle.nullness",
            "version_fields",
            "refcount_initial",
            "memory_pointer_identity",
            "default_modules_installed"
          ]
        },
        "fixture_requirements": [
          "future ABI runner must provide a counting FT_MemoryRec allocator"
        ],
        "source_refs": [
          "freetype/src/base/ftobjs.c:FT_New_Library",
          "freetype/include/freetype/ftmodapi.h"
        ]
      }
    },
    {
      "case_id": "ftmodapi.FT_New_Library.rejects_null_inputs_preserving_output",
      "subject": "ftmodapi.FT_New_Library",
      "case": "rejects_null_inputs_preserving_output",
      "operation": "ftmodapi.new_library",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "assets": {},
        "params": {
          "scenarios": [
            {
              "memory": "null",
              "alibrary": "sentinel_pointer"
            },
            {
              "memory": "valid_counting_FT_MemoryRec",
              "alibrary": "null"
            }
          ],
          "sentinel_policy": "output pointer is not written on invalid arguments"
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftmodapi",
        "area:library",
        "area:error"
      ],
      "expectation": {
        "status": "error",
        "error": "FT_Err_Invalid_Argument",
        "output_shape": {
          "status": "FT_Error",
          "alibrary_after": "sentinel_or_unavailable",
          "allocator_calls": "none"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "status",
            "alibrary_after",
            "allocator_calls"
          ]
        },
        "source_refs": [
          "freetype/src/base/ftobjs.c:FT_New_Library"
        ]
      }
    },
