                "FT_Get_Glyph svg",
                "FT_Glyph_Copy svg",
                "FT_Glyph_Transform svg"
              ],
              "face_index": 0,
              "pixel_size": 20,
              "load_flags": [
                "FT_LOAD_COLOR"
              ],
              "glyph_index": 1
