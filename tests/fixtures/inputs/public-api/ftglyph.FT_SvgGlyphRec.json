          "mode": "exact",
          "paths": [
            "feature_available",
            "record.root",
            "record.svg_document_length",
            "record.document_hash",
            "record.metrics",
            "record.transform",
            "record.delta"
          ]
        },
        "source_refs": [
          "freetype/include/freetype/ftglyph.h",
          "freetype/src/base/ftglyph.c"
        ],
        "fixture_requirements": [
          "input/fonts/svg/otsvg-glyph.ttf contains one project-authored plain-XML OpenType SVG document covering glyph index 1."
        ]
      }
    },
    {
      "case_id": "ftglyph.FT_SvgGlyphRec.svg_feature_disabled_classification",
      "subject": "ftglyph.FT_SvgGlyphRec",
