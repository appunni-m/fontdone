      "inputs": {
        "assets": {
          "svg_font": {
            "kind": "ref",
            "id": "input/fonts/DejaVuSans.ttf",
            "asset_kind": "font",
            "optional": true
          }
        },
        "params": {
          "probe": "compile/runtime svg glyph class availability",
          "runtime_route": "actual_svg_feature_probe"
        }
      },
      "classifiers": [
        "kind:record",
        "header:ftglyph"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "feature": "FT_CONFIG_OPTION_SVG",
          "classification": "unsupported when disabled"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "feature_available",
            "classification"
          ]
        },
        "source_refs": [
          "freetype/include/freetype/ftglyph.h",
          "freetype/src/base/ftglyph.c"
        ],
        "fixture_requirements": [
          "input/fonts/DejaVuSans.ttf is optional and must contain a valid OT-SVG document for SVG rows; builds without FT_CONFIG_OPTION_SVG classify these rows as unsupported."
        ]
      }
