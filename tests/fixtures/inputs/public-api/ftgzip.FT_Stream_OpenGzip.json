    {
      "case_id": "ftgzip.FT_Stream_OpenGzip.opens_valid_gzip_stream",
      "subject": "ftgzip.FT_Stream_OpenGzip",
      "case": "opens_valid_gzip_stream",
      "operation": "ftgzip.stream_open_gzip",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "gzip_streams": {
            "kind": "ref",
            "id": "compressed/gzip/small-and-large-streams.json"
          }
        },
        "params": {
          "target_stream": "zeroed caller stream",
          "source_stream_positions": [
            0,
            "nonzero_before_header"
          ],
          "read_ranges": [
            "beginning",
            "middle",
            "end"
          ],
          "small_stream_threshold": 40960
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftgzip"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "status": "FT_Error",
          "stream": {
            "size": "FT_ULong or sentinel for unknown",
            "base": "nullable in-memory buffer",
            "read": "nullable callback",
            "close": "callback"
          },
          "read_bytes": "decompressed byte ranges"
        },
        "compare": {
          "mode": "bytes",
          "paths": [
            "status",
            "stream.size",
            "stream.base_class",
            "stream.read_class",
            "stream.close_class",
            "read_ranges[*].bytes"
          ]
        },
        "fixture_requirements": [
          "compressed/gzip/small-and-large-streams.json must include one gzip stream below and one above the 40KiB in-memory threshold"
        ],
        "source_refs": [
          "freetype/include/freetype/ftgzip.h:63-91",
          "freetype/src/gzip/ftgzip.c:608-708"
        ]
      }
    },
